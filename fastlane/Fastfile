default_platform(:android)

PROJECT_ROOT = File.expand_path("..", __dir__)

platform :android do
  desc "Build and publish PlayTable to Google Play Store"
  lane :deploy do |options|
    track = options[:track] || 'production'
    
    sh("../build_aab.sh")
    
    upload_to_play_store(
      track: track,
      aab: '../build/android/PlayTable.aab',
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: '/Users/sierra/Dev/keystores/play-store-api-key.json',
      package_name: 'org.playtable.app'
    )
  end

  desc "Sync Store Metadata only"
  lane :sync_metadata do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: '/Users/sierra/Dev/keystores/play-store-api-key.json',
      package_name: 'org.playtable.app'
    )
  end
end

platform :ios do
  private_lane :playtable_app_store_connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_CONNECT_API_PRIVATE_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Export, sign and archive the iOS Xcode project"
  lane :build do
    sh("bash #{File.join(PROJECT_ROOT, 'scripts', 'ios_export.sh')}")

    team_id = ENV.fetch("APPLE_TEAM_ID", "28X7P94SF5")
    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")

    gym(
      project: File.join(PROJECT_ROOT, "build/ios/PlayTable.xcodeproj"),
      scheme: "PlayTable",
      configuration: "Release",
      clean: true,
      output_directory: File.join(PROJECT_ROOT, "build/ios"),
      output_name: "PlayTable.ipa",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{team_id} " \
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}' " \
        "CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          ENV.fetch("IOS_BUNDLE_ID", "org.playtable.app") =>
            ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
        }
      }
    )
  end

  desc "Upload the signed IPA to TestFlight"
  lane :upload_testflight do
    pilot(
      api_key: playtable_app_store_connect_api_key,
      ipa: File.join(PROJECT_ROOT, "build/ios/PlayTable.ipa"),
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload the signed IPA to the App Store version"
  lane :upload_appstore do
    review_notes_path = File.join(PROJECT_ROOT, "fastlane/metadata/review_information/notes.txt")
    review_notes = File.read(review_notes_path).strip
    recording_reference = ENV.fetch("IOS_REVIEW_RECORDING_REFERENCE", "").strip
    if ENV.fetch("IOS_SUBMIT_FOR_REVIEW", "false").casecmp("true").zero? && recording_reference.empty?
      UI.user_error!("IOS_REVIEW_RECORDING_REFERENCE must point to the physical-device recording before submitting for review")
    end
    review_notes += "\n\nPhysical-device recording reference: #{recording_reference}" unless recording_reference.empty?
    if review_notes.bytesize > 4000
      UI.user_error!("App Review notes exceed Apple's 4000-byte limit")
    end

    attachment_path = File.join(PROJECT_ROOT, "fastlane/metadata/review_information/playtable_review_demo.mp4")

    deliver(
      api_key: playtable_app_store_connect_api_key,
      ipa: File.join(PROJECT_ROOT, "build/ios/PlayTable.ipa"),
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "org.playtable.app"),
      metadata_path: File.join(PROJECT_ROOT, "fastlane/metadata"),
      screenshots_path: File.join(PROJECT_ROOT, "fastlane/screenshots"),
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: ENV.fetch("IOS_SUBMIT_FOR_REVIEW", "false") == "true",
      automatic_release: ENV.fetch("IOS_AUTOMATIC_RELEASE", "true") == "true",
      force: true,
      run_precheck_before_submit: false,
      app_review_attachment_file: File.exist?(attachment_path) ? attachment_path : nil,
      app_review_information: {
        first_name: ENV.fetch("IOS_REVIEW_FIRST_NAME", "Ricardo"),
        last_name: ENV.fetch("IOS_REVIEW_LAST_NAME", "Sierra"),
        phone_number: ENV.fetch("IOS_REVIEW_PHONE", "+55 21 99919-3898"),
        email_address: ENV.fetch("IOS_REVIEW_EMAIL", "sierra.csi@gmail.com"),
        notes: review_notes
      },
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: ENV.fetch("IOS_EXPORT_COMPLIANCE_USES_ENCRYPTION").casecmp("true").zero?,
        export_compliance_is_exempt: ENV.fetch("IOS_EXPORT_COMPLIANCE_IS_EXEMPT").casecmp("true").zero?,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      }
    )
  end
end
