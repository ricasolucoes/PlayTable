# Security - NEVER commit these
release.keystore
*.keystore
*.jks
*.p12
*.pepk
keystore.properties

# NOTE: export_presets.cfg IS committed on purpose (F-Droid needs it to build).
# It must never contain a keystore path, alias or password.

# Python
__pycache__/
*.pyc
.pytest_cache/

# Planning/Local
.planning/

# Godot addons de terceiros (buscados por tests/install_gut.sh)
/addons/

# Relatorio JUnit gerado pela suite GUT
/.gut_report/

# --- Artefatos de assinatura e segredos ---
# Chave privada e senha no mesmo repositorio = identidade de publicacao comprometida.
# Chave de assinatura Android nao pode ser trocada depois que o app esta publicado.
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.jceks
*.mobileprovision
*.provisionprofile
*.pem
*.key
*.ppk
key.properties
keystore.properties
signing.properties
local.properties
google-services.json
GoogleService-Info.plist
id_rsa
id_dsa
id_ecdsa
id_ed25519
