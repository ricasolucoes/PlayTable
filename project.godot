; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PlayTable"
config/description="Coleção de jogos de tabuleiro e cartas offline em 3D imersivo."
config/icon="res://icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="user_data"
run/main_scene="res://core/telas/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[gui]

theme/custom="res://shared/theme/MainTheme.tres"

[autoload]

; Ordem importa: a ordem de registro e a ordem em que os autoloads conectam nos
; sinais do GameEventBus, e portanto a ordem em que reagem. O
; GamificationManager precisa normalizar o resultado da partida (contadores,
; recordes, flags, streak) ANTES que conquista, missao, maestria, liga e Play
; Games leiam o perfil -- senao todos avaliam o estado da partida anterior.
SaveManager="*res://core/save/SaveManager.gd"
LocaleManager="*res://core/i18n/LocaleManager.gd"
SceneManager="*res://core/navegacao/SceneManager.gd"
AudioManager="*res://core/audio/AudioManager.gd"
GameEventBus="*res://core/services/GameEventBus.gd"
PlayerProfile="*res://core/services/PlayerProfile.gd"
SecurityManager="*res://core/services/SecurityManager.gd"
LiveOpsManager="*res://core/services/LiveOpsManager.gd"
RewardSystem="*res://core/services/RewardSystem.gd"
DifficultyManager="*res://core/services/DifficultyManager.gd"
GamificationManager="*res://core/services/GamificationManager.gd"
MasteryEngine="*res://core/services/MasteryEngine.gd"
LeagueSystem="*res://core/services/LeagueSystem.gd"
CollectionSystem="*res://core/services/CollectionSystem.gd"
AchievementEngine="*res://core/services/AchievementEngine.gd"
QuestEngine="*res://core/services/QuestEngine.gd"
LeaderboardSync="*res://core/services/LeaderboardSync.gd"
PlayGamesManager="*res://core/services/PlayGamesManager.gd"
CloudSaveSync="*res://core/save/CloudSaveSync.gd"
EngagementManager="*res://core/services/EngagementManager.gd"

[internationalization]

locale/translations=PackedStringArray("res://core/i18n/translations.en.translation", "res://core/i18n/translations.es.translation", "res://core/i18n/translations.pt_BR.translation")


[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2

[debug]

file_logging/enable_file_logging=false
