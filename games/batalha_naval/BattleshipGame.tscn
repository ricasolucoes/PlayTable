[gd_scene load_steps=2 format=3 uid="uid://battleshipuid"]

[ext_resource type="Script" path="res://games/batalha_naval/BattleshipGame.gd" id="1_script"]

[node name="BattleshipGame" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.1, 0.16, 1)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 30.0
offset_right = -20.0
offset_bottom = -30.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="BtnBack" type="Button" parent="VBoxContainer/TopBar"]
custom_minimum_size = Vector2(100, 50)
layout_mode = 2
text = "Voltar"

[node name="Title" type="Label" parent="VBoxContainer/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Batalha Naval"

[node name="FleetInfoLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.85, 0.95, 1)
theme_override_font_sizes/font_size = 20
text = "Inimigo Afundado: 0/5  |  Sua Frota Afundada: 0/5"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Posicione sua frota e clique em Iniciar!"
horizontal_alignment = 1

[node name="TabButtons" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 15
alignment = 1

[node name="BtnTabRadar" type="Button" parent="VBoxContainer/TabButtons"]
custom_minimum_size = Vector2(200, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "🎯 Radar Inimigo"

[node name="BtnTabFleet" type="Button" parent="VBoxContainer/TabButtons"]
custom_minimum_size = Vector2(200, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "🚢 Minha Frota"

[node name="CenterContainer" type="CenterContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="RadarContainer" type="PanelContainer" parent="VBoxContainer/CenterContainer"]
layout_mode = 2

[node name="GridRadar" type="GridContainer" parent="VBoxContainer/CenterContainer/RadarContainer"]
layout_mode = 2
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2
columns = 10

[node name="FleetContainer" type="PanelContainer" parent="VBoxContainer/CenterContainer"]
visible = false
layout_mode = 2

[node name="GridFleet" type="GridContainer" parent="VBoxContainer/CenterContainer/FleetContainer"]
layout_mode = 2
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2
columns = 10

[node name="ControlButtons" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="BtnRandomize" type="Button" parent="VBoxContainer/ControlButtons"]
custom_minimum_size = Vector2(180, 55)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "🎲 Reposicionar"

[node name="BtnStart" type="Button" parent="VBoxContainer/ControlButtons"]
custom_minimum_size = Vector2(180, 55)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "⚔️ Iniciar Batalha"

[node name="BtnRestart" type="Button" parent="VBoxContainer/ControlButtons"]
visible = false
custom_minimum_size = Vector2(240, 55)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Nova Batalha"

[connection signal="pressed" from="VBoxContainer/TopBar/BtnBack" to="." method="_on_btn_back_pressed"]
[connection signal="pressed" from="VBoxContainer/TabButtons/BtnTabRadar" to="." method="_on_btn_tab_radar_pressed"]
