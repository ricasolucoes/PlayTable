[gd_scene load_steps=2 format=3 uid="uid://blackjack"]

[ext_resource type="Script" path="res://games/blackjack/BlackjackGame.gd" id="1_script"]

[node name="BlackjackGame" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.25, 0.12, 1)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 30.0
offset_right = -20.0
offset_bottom = -30.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="TopBar" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="BtnBack" type="Button" parent="VBoxContainer/TopBar"]
custom_minimum_size = Vector2(100, 50)
layout_mode = 2
text = "Voltar"

[node name="Title" type="Label" parent="VBoxContainer/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "21 (Blackjack)"

[node name="Header" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="ChipsLabel" type="Label" parent="VBoxContainer/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 24
text = "💰 Fichas: 100"

[node name="BetLabel" type="Label" parent="VBoxContainer/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Aposta: 10"

[node name="DealerArea" type="VBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Label" type="Label" parent="VBoxContainer/DealerArea"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Dealer:"
horizontal_alignment = 1

[node name="DealerCards" type="HBoxContainer" parent="VBoxContainer/DealerArea"]
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="PlayerArea" type="VBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Label" type="Label" parent="VBoxContainer/PlayerArea"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Você:"
horizontal_alignment = 1

[node name="PlayerCards" type="HBoxContainer" parent="VBoxContainer/PlayerArea"]
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Status" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Sua Vez!"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 15
alignment = 1

[node name="BtnHit" type="Button" parent="VBoxContainer/Buttons"]
custom_minimum_size = Vector2(130, 60)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Comprar"

[node name="BtnStand" type="Button" parent="VBoxContainer/Buttons"]
custom_minimum_size = Vector2(130, 60)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Parar"

[node name="BtnDouble" type="Button" parent="VBoxContainer/Buttons"]
custom_minimum_size = Vector2(130, 60)
