[connection signal="pressed" from="VBoxContainer/TopBar/BtnBack" to="." method="_on_btn_back_pressed"]
[connection signal="pressed" from="VBoxContainer/Buttons/BtnHit" to="." method="_on_btn_hit_pressed"]
[connection signal="pressed" from="VBoxContainer/Buttons/BtnStand" to="." method="_on_btn_stand_pressed"]
[connection signal="pressed" from="VBoxContainer/Buttons/BtnDouble" to="." method="_on_btn_double_pressed"]
